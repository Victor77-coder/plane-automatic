# Personal Access Token do Plane (Profile Settings → Personal Access Tokens)
PLANE_API_KEY=

# Instância Plane (self-hosted ou cloud)
PLANE_BASE_URL=https://sua-instancia.example

# Slug do workspace — só o nome, não a URL.
# Em https://<instancia>/<slug>/projects/ o slug é o primeiro segmento do path.
PLANE_WORKSPACE_SLUG=

# UUID do projeto de Suporte (só o UUID)
# Descubra com: python -m plane_cli projects
PLANE_SUPPORT_PROJECT_ID=

# IA para redigir templates. O relato (incluindo dados de cliente) é enviado
# ao provedor escolhido. groq (default) ou openai.
# Se groq não tiver chave, tenta OPENAI_API_KEY.
PLANE_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Endpoint OpenAI-compatível (proxy interno). Default: https://api.openai.com/v1
# OPENAI_BASE_URL=
