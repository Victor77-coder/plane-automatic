# Personal Access Token do Plane (Profile Settings → Personal Access Tokens)
PLANE_API_KEY=

# Instância self-hosted
PLANE_BASE_URL=https://plane.promaxima.cloud

# Slug do workspace — só o nome, não a URL.
# Em https://plane.promaxima.cloud/dynamics/projects/ o slug é: dynamics
PLANE_WORKSPACE_SLUG=dynamics

# UUID do projeto de Suporte (só o UUID, sem /issues/)
# Descubra com: python -m plane_cli projects
PLANE_SUPPORT_PROJECT_ID=

# IA para redigir a demanda técnica (não copia o texto do suporte)
# groq (default) ou openai. Se groq não tiver chave, tenta OPENAI_API_KEY.
PLANE_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

